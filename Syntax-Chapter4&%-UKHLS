********************************************************************************
********************************************************************************
* UKHLS CHAPTERS 4 AND 5
* HEALTH, EMPLOYMENT AND LIFE SATISFACTION
*
* GitHub appendix
*
* Main analyses:
*
*   A. Health and employment outcomes - random-effects xtlogit
*   B. Health, employment and life satisfaction - random-effects xtreg
*   C. Health and occupation - survey-weighted multinomial logit
*   D. Disability onset and labour-market participation
*
********************************************************************************
********************************************************************************

estimates clear


********************************************************************************
* 1. SELECT EMPLOYMENT OUTCOME(S)
*
* local run_outcomes "PEET"
*
* To run all outcomes: "`employment_outcomes'"
********************************************************************************

local employment_outcomes ///
    PEET ///
    PartTime ///
    TempJob ///
    SelfEmployed ///
    ZeroHours ///
    FlexiTime ///
    WorkHome ///
    Sector ///
    MayLoseJob ///
    MayQuitJob


local run_outcomes "PEET"


********************************************************************************
* 2. ANALYSIS SWITCHES
*
* 1 = run
* 0 = do not run
*
********************************************************************************

local run_employment_models 1
local run_lifesat_models    1
local make_employment_graphs 1
local make_lifesat_graphs    1



********************************************************************************
********************************************************************************
* HEALTH AND EMPLOYMENT OUTCOMES
* RANDOM-EFFECTS LOGISTIC REGRESSION
********************************************************************************
********************************************************************************


capture program drop UKHLS_EmploymentHealth

program define UKHLS_EmploymentHealth

    args outcome prefix makegraphs


    display _newline
    display "============================================================"
    display "UKHLS EMPLOYMENT OUTCOME: `outcome'"
    display "============================================================"


    *--------------------------------------------------------------------------*
    * Controls
    *--------------------------------------------------------------------------*

    local controls ///
        Fem ///
        dvage ///
        Age2 ///
        HighEducation ///
        White ///
        AfricanCaribbean ///
        Asian ///
        Indian ///
        Arab ///
        Mixed ///
        Other ///
        Single ///
        Seperated


    *--------------------------------------------------------------------------*
    * Specific health conditions
    *--------------------------------------------------------------------------*

    local conditions ///
        MentalHealth ///
        Epilepsy ///
        Thyroid ///
        Lung ///
        Heart ///
        Arthritis ///
        Diabetes ///
        Cancer ///
        Liver


    *--------------------------------------------------------------------------*
    * Functional limitations
    *--------------------------------------------------------------------------*

    local limitations ///
        Mobility ///
        Lifting ///
        ManualDexterity ///
        Continence ///
        Hearing ///
        Sight ///
        Communication ///
        Memory ///
        RDanger ///
        Coordination ///
        PersonalCare ///
        OtherHCPB


    ****************************************************************************
    * A1. DISABILITY
    ****************************************************************************

    xtlogit `outcome' ///
        `controls' ///
        Disabled, ///
        re i(pidp)

    estimates store `prefix'_Dis


    ****************************************************************************
    * A2. ANY HEALTH CONDITION
    ****************************************************************************

    xtlogit `outcome' ///
        `controls' ///
        HealthCondition, ///
        re i(pidp)

    estimates store `prefix'_HC


    ****************************************************************************
    * A3. POOR SELF-RATED HEALTH
    ****************************************************************************

    xtlogit `outcome' ///
        `controls' ///
        HealthNotGood, ///
        re i(pidp)

    estimates store `prefix'_Poor


    ****************************************************************************
    * A4. SPECIFIC HEALTH CONDITIONS
    *
    * HasHC controls for having any health condition.
    ****************************************************************************

    foreach x of local conditions {

        xtlogit `outcome' ///
            `controls' ///
            HasHC ///
            `x', ///
            re i(pidp)

        estimates store `prefix'_HC_`x'

    }


    ****************************************************************************
    * A5. OVERALL INHIBITING / FUNCTIONAL LIMITATION
    ****************************************************************************

    xtlogit `outcome' ///
        `controls' ///
        Inhibiting_Symptom, ///
        re i(pidp)

    estimates store `prefix'_PB


    ****************************************************************************
    * A6. SPECIFIC FUNCTIONAL LIMITATIONS
    *
    * HasPB controls for the presence of an inhibiting limitation.
    ****************************************************************************

    foreach x of local limitations {

        xtlogit `outcome' ///
            `controls' ///
            HasPB ///
            `x', ///
            re i(pidp)

        estimates store `prefix'_PB_`x'

    }


    ****************************************************************************
    * A7. HEALTH CONDITION RESULTS TABLE
    ****************************************************************************

    estimates table ///
        `prefix'_Dis ///
        `prefix'_HC ///
        `prefix'_Poor ///
        `prefix'_HC_MentalHealth ///
        `prefix'_HC_Epilepsy ///
        `prefix'_HC_Thyroid ///
        `prefix'_HC_Lung ///
        `prefix'_HC_Heart ///
        `prefix'_HC_Arthritis ///
        `prefix'_HC_Diabetes ///
        `prefix'_HC_Cancer ///
        `prefix'_HC_Liver, ///
        stats(N ll bic rho r2_p) ///
        b(%8.4g) ///
        star


    ****************************************************************************
    * A8. FUNCTIONAL LIMITATION RESULTS TABLE
    ****************************************************************************

    estimates table ///
        `prefix'_PB ///
        `prefix'_PB_Mobility ///
        `prefix'_PB_Lifting ///
        `prefix'_PB_ManualDexterity ///
        `prefix'_PB_Continence ///
        `prefix'_PB_Hearing ///
        `prefix'_PB_Sight ///
        `prefix'_PB_Communication ///
        `prefix'_PB_Memory ///
        `prefix'_PB_RDanger ///
        `prefix'_PB_Coordination ///
        `prefix'_PB_PersonalCare ///
        `prefix'_PB_OtherHCPB, ///
        stats(N ll bic rho r2_p) ///
        b(%8.4g) ///
        star



********************************************************************************
********************************************************************************
* PART B
* LIFE SATISFACTION × EMPLOYMENT × HEALTH
*
* Random-effects linear regression
********************************************************************************
********************************************************************************


capture program drop UKHLS_LifeSat

program define UKHLS_LifeSat

    args outcome prefix makegraphs


    display _newline
    display "============================================================"
    display "LIFE SATISFACTION × `outcome'"
    display "============================================================"


    *--------------------------------------------------------------------------*
    * Controls used in condition/symptom interaction models
    *--------------------------------------------------------------------------*

    local controls ///
        Fem ///
        dvage ///
        Age2 ///
        HighEducation ///
        WhiteOther ///
        OtherEthnicity ///
        Single ///
        Seperated


    *--------------------------------------------------------------------------*
    * Health conditions
    *--------------------------------------------------------------------------*

    local conditions ///
        MentalHealth ///
        Epilepsy ///
        Thyroid ///
        Lung ///
        Heart ///
        Arthritis ///
        Diabetes ///
        Cancer ///
        Liver


    *--------------------------------------------------------------------------*
    * Functional limitations
    *--------------------------------------------------------------------------*

    local symptoms ///
        Lifting ///
        Mobility ///
        ManualDexterity ///
        Continence ///
        Hearing ///
        Sight ///
        Communication ///
        Memory ///
        RDanger ///
        Coordination ///
        PersonalCare


    ****************************************************************************
    * B1. SPECIFIC HEALTH CONDITIONS
    ****************************************************************************

    foreach var of local conditions {

        xtreg LifeSat ///
            i.`outcome'##i.HasHC ///
            `controls' ///
            i.`outcome'##i.`var' ///
            if hcmiss==0, ///
            re i(pidp)

        estimates store LS_`prefix'_`var'


        *----------------------------------------------------------------------*
        * Test focal interaction
        *----------------------------------------------------------------------*

        testparm i.`outcome'#i.`var'

        local pval = r(p)


        *----------------------------------------------------------------------*
        * Margins
        *----------------------------------------------------------------------*

        margins, ///
            at(`outcome'=(0 1) `var'=(0 1)) ///
            level(95)


        *----------------------------------------------------------------------*
        * Graph
        *----------------------------------------------------------------------*

        if `makegraphs' == 1 {

            if `pval' < 0.05 {

                marginsplot, ///
                    scheme(Rainbow) ///
                    plotopts( ///
                        lwidth(medthick) ///
                        lcolor(%70) ///
                        msize(medium) ///
                        mlcolor(yellow) ///
                        mcolor(%75) ///
                    ) ///
                    recastci(rarea) ///
                    ciopts(fcolor(%40)) ///
                    title("`var'", size(medium)) ///
                    xsize(5) ysize(5) ///
                    xlabel(0 "No" 1 "Yes") ///
                    xscale(range(-0.15 1.15)) ///
                    ylab(, glcolor(gs15) glpattern(solid)) ///
                    ytitle("Life Satisfaction") ///
                    xtitle("") ///
                    legend(pos(6) ring(2) col(1) size(vsmall)) ///
                    saving(`var'_`prefix'.gph, replace)

            }

            else {

                marginsplot, ///
                    scheme(tab2) ///
                    plotopts( ///
                        lwidth(medthick) ///
                        lcolor(%70) ///
                        msize(medium) ///
                        mlcolor(yellow) ///
                        mcolor(%75) ///
                    ) ///
                    recastci(rarea) ///
                    ciopts(fcolor(%40)) ///
                    title("`var'", size(medium)) ///
                    xsize(5) ysize(5) ///
                    xlabel(0 "No" 1 "Yes") ///
                    xscale(range(-0.15 1.15)) ///
                    ylab(, glcolor(gs15) glpattern(solid)) ///
                    ytitle("Life Satisfaction") ///
                    xtitle("") ///
                    legend(pos(6) ring(2) col(1) size(vsmall)) ///
                    saving(`var'_`prefix'.gph, replace)

            }
        }
    }


    ****************************************************************************
    * B2. SPECIFIC FUNCTIONAL LIMITATIONS
    ****************************************************************************

    foreach var of local symptoms {

        xtreg LifeSat ///
            i.`outcome'##i.HasPB ///
            `controls' ///
            i.`outcome'##i.`var' ///
            if pbmiss==0, ///
            re i(pidp)

        estimates store LS_`prefix'_`var'


        testparm i.`outcome'#i.`var'

        local pval = r(p)


        margins, ///
            at(`outcome'=(0 1) `var'=(0 1)) ///
            level(95)


        if `makegraphs' == 1 {

            if `pval' < 0.05 {

                marginsplot, ///
                    scheme(Rainbow) ///
                    plotopts( ///
                        lwidth(medthick) ///
                        lcolor(%70) ///
                        msize(medium) ///
                        mlcolor(yellow) ///
                        mcolor(%75) ///
                    ) ///
                    recastci(rarea) ///
                    ciopts(fcolor(%40)) ///
                    title("`var'", size(medium)) ///
                    xsize(5) ysize(5) ///
                    xlabel(0 "No" 1 "Yes") ///
                    xscale(range(-0.15 1.15)) ///
                    ylab(, glcolor(gs15) glpattern(solid)) ///
                    ytitle("Life Satisfaction") ///
                    xtitle("") ///
                    legend(pos(6) ring(2) col(1) size(vsmall)) ///
                    saving(`var'_`prefix'.gph, replace)

            }

            else {

                marginsplot, ///
                    scheme(tab2) ///
                    plotopts( ///
                        lwidth(medthick) ///
                        lcolor(%70) ///
                        msize(medium) ///
                        mlcolor(yellow) ///
                        mcolor(%75) ///
                    ) ///
                    recastci(rarea) ///
                    ciopts(fcolor(%40)) ///
                    title("`var'", size(medium)) ///
                    xsize(5) ysize(5) ///
                    xlabel(0 "No" 1 "Yes") ///
                    xscale(range(-0.15 1.15)) ///
                    ylab(, glcolor(gs15) glpattern(solid)) ///
                    ytitle("Life Satisfaction") ///
                    xtitle("") ///
                    legend(pos(6) ring(2) col(1) size(vsmall)) ///
                    saving(`var'_`prefix'.gph, replace)

            }
        }
    }


    ****************************************************************************
    * B3. DISABILITY
    ****************************************************************************

    xtreg LifeSat ///
        `controls' ///
        i.`outcome'##i.Disabled, ///
        re i(pidp)

    estimates store LS_`prefix'_Disabled

    testparm i.`outcome'#i.Disabled

    local pval = r(p)

    margins, at(`outcome'=(0 1) Disabled=(0 1))


    if `makegraphs' == 1 {

        if `pval' < 0.05 local graphscheme "Rainbow"
        else             local graphscheme "tab2"

        marginsplot, ///
            scheme(`graphscheme') ///
            recastci(rarea) ///
            title("Disabled", size(medium)) ///
            xlabel(0 "No" 1 "Yes") ///
            ytitle("Life Satisfaction") ///
            xtitle("") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(Disabled_`prefix'.gph, replace)

    }


    ****************************************************************************
    * B4. POOR SELF-RATED HEALTH
    ****************************************************************************

    xtreg LifeSat ///
        `controls' ///
        i.`outcome'##i.HealthNotGood, ///
        re i(pidp)

    estimates store LS_`prefix'_PoorHealth

    testparm i.`outcome'#i.HealthNotGood

    local pval = r(p)

    margins, at(`outcome'=(0 1) HealthNotGood=(0 1))


    if `makegraphs' == 1 {

        if `pval' < 0.05 local graphscheme "Rainbow"
        else             local graphscheme "tab2"

        marginsplot, ///
            scheme(`graphscheme') ///
            recastci(rarea) ///
            title("Poor Health", size(medium)) ///
            xlabel(0 "No" 1 "Yes") ///
            ytitle("Life Satisfaction") ///
            xtitle("") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(HealthNotGood_`prefix'.gph, replace)

    }


    ****************************************************************************
    * B5. ANY HEALTH CONDITION
    ****************************************************************************

    xtreg LifeSat ///
        `controls' ///
        i.`outcome'##i.HasHC ///
        if hcmiss==0, ///
        re i(pidp)

    estimates store LS_`prefix'_HasHC

    testparm i.`outcome'#i.HasHC

    local pval = r(p)

    margins, at(`outcome'=(0 1) HasHC=(0 1))


    if `makegraphs' == 1 {

        if `pval' < 0.05 local graphscheme "Rainbow"
        else             local graphscheme "tab2"

        marginsplot, ///
            scheme(`graphscheme') ///
            recastci(rarea) ///
            title("Health Condition", size(medium)) ///
            xlabel(0 "No" 1 "Yes") ///
            ytitle("Life Satisfaction") ///
            xtitle("") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(HasHC_`prefix'.gph, replace)

    }


    ****************************************************************************
    * B6. ANY INHIBITING FUNCTIONAL LIMITATION
    ****************************************************************************

    xtreg LifeSat ///
        `controls' ///
        i.`outcome'##i.Inhibiting_Symptom ///
        if pbmiss==0, ///
        re i(pidp)

    estimates store LS_`prefix'_Inhibiting

    testparm i.`outcome'#i.Inhibiting_Symptom

    local pval = r(p)

    margins, ///
        at(`outcome'=(0 1) Inhibiting_Symptom=(0 1))


    if `makegraphs' == 1 {

        if `pval' < 0.05 local graphscheme "Rainbow"
        else             local graphscheme "tab2"

        marginsplot, ///
            scheme(`graphscheme') ///
            recastci(rarea) ///
            title("Inhibiting Symptom", size(medium)) ///
            xlabel(0 "No" 1 "Yes") ///
            ytitle("Life Satisfaction") ///
            xtitle("") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(Inhibiting_Symptom_`prefix'.gph, replace)

    }


    ****************************************************************************
    * B7. COMBINED LIFE SATISFACTION GRAPHS
    ****************************************************************************

    if `makegraphs' == 1 {

        graph combine ///
            MentalHealth_`prefix'.gph ///
            Epilepsy_`prefix'.gph ///
            Thyroid_`prefix'.gph ///
            Lung_`prefix'.gph ///
            Heart_`prefix'.gph ///
            Arthritis_`prefix'.gph ///
            Diabetes_`prefix'.gph ///
            Cancer_`prefix'.gph ///
            Liver_`prefix'.gph ///
            Disabled_`prefix'.gph ///
            HealthNotGood_`prefix'.gph ///
            HasHC_`prefix'.gph, ///
            name(LS_`prefix'_HC, replace) ///
            title("Health Condition", size(medium))


        graph combine ///
            Lifting_`prefix'.gph ///
            Mobility_`prefix'.gph ///
            ManualDexterity_`prefix'.gph ///
            Continence_`prefix'.gph ///
            Hearing_`prefix'.gph ///
            Sight_`prefix'.gph ///
            Communication_`prefix'.gph ///
            Memory_`prefix'.gph ///
            RDanger_`prefix'.gph ///
            Coordination_`prefix'.gph ///
            PersonalCare_`prefix'.gph ///
            Inhibiting_Symptom_`prefix'.gph, ///
            name(LS_`prefix'_PB, replace) ///
            title("Inhibiting Health Condition Symptoms", size(medium))


        graph combine ///
            LS_`prefix'_HC ///
            LS_`prefix'_PB, ///
            name(LS_`prefix'_Combined, replace) ///
            title( ///
                "UKHLS: Life Satisfaction, Health and `outcome'", ///
                size(medium) ///
            ) ///
            note( ///
                "Adjusted margins from separate random-effects regression models using UKHLS.", ///
                span size(*.7) margin(vsmall) ///
            ) ///
            caption( ///
                "Orange graphs indicate statistically significant interactions; blue graphs indicate non-significant interactions.", ///
                span size(*.4) margin(vsmall) ///
            ) ///
            xsize(16) ysize(9) ///
            graphregion(margin(l=4 r=4))

    }

end



********************************************************************************
********************************************************************************
* PART C
* RUN SELECTED EMPLOYMENT OUTCOME(S)
********************************************************************************
********************************************************************************


foreach outcome of local run_outcomes {


    ****************************************************************************
    * Assign short model prefix
    ****************************************************************************

    if "`outcome'" == "PEET"              local prefix "PEET"
    else if "`outcome'" == "PartTime"     local prefix "PT"
    else if "`outcome'" == "TempJob"      local prefix "TEMP"
    else if "`outcome'" == "SelfEmployed" local prefix "SELF"
    else if "`outcome'" == "ZeroHours"    local prefix "ZH"
    else if "`outcome'" == "FlexiTime"    local prefix "FLEX"
    else if "`outcome'" == "WorkHome"     local prefix "WH"
    else if "`outcome'" == "Sector"       local prefix "SECTOR"
    else if "`outcome'" == "MayLoseJob"   local prefix "LOSE"
    else if "`outcome'" == "MayQuitJob"   local prefix "QUIT"


    ****************************************************************************
    * Employment outcome models
    ****************************************************************************

    if `run_employment_models' == 1 {

        UKHLS_EmploymentHealth ///
            `outcome' ///
            `prefix' ///
            `make_employment_graphs'

    }


    ****************************************************************************
    * Life Satisfaction models
    ****************************************************************************

    if `run_lifesat_models' == 1 {

        UKHLS_LifeSat ///
            `outcome' ///
            `prefix' ///
            `make_lifesat_graphs'

    }

}



