********************************************************************************
* DISABILITY ONSET AND LABOUR MARKET PARTICIPATION
* UKHLS
*
* Purpose:
* Examine employment and PEET trajectories surrounding the first observed
* onset of disability among respondents who entered the panel non-disabled.
*
* Main analyses:
*   1. Employment at disability onset
*   2. PEET at disability onset
*   3. Employment exit at disability onset
*   4. Event-time employment model
*   5. Event-time PEET model
*   6. Random-effects employment model
*   7. Fixed-effects employment model
*
* Event-time reference:
* One wave before first observed disability onset
********************************************************************************


********************************************************************************
* 0. PREPARATION
********************************************************************************

sort pidp wave


********************************************************************************
* 1. IDENTIFY FIRST OBSERVATION FOR EACH PERSON
********************************************************************************

capture drop first_obs

bysort pidp (wave): gen first_obs = (_n==1)

tab first_obs


********************************************************************************
* 2. IDENTIFY PEOPLE DISABLED WHEN THEY ENTER THE PANEL
*
* These respondents are excluded from the disability-onset analysis because
* their transition into disability is not observed during the panel.
********************************************************************************

capture drop disabled_at_entry

bysort pidp: egen disabled_at_entry = ///
    max(first_obs==1 & Disabled==1)

tab disabled_at_entry


********************************************************************************
* 3. IDENTIFY FIRST OBSERVED DISABILITY WAVE
********************************************************************************

capture drop first_disability_wave

bysort pidp (wave): egen first_disability_wave = ///
    min(cond(Disabled==1, wave, .))

tab first_disability_wave, missing


********************************************************************************
* 4. IDENTIFY DISABILITY-ONSET WAVE
*
* acquired_disability = 1 only in the first wave in which disability is
* observed.
********************************************************************************

capture drop acquired_disability

gen acquired_disability = ///
    (wave==first_disability_wave) ///
    if first_disability_wave<.

tab acquired_disability, missing


********************************************************************************
* 5. CREATE EVENT-TIME VARIABLE
*
* disability_eventtime:
*
* -3 = three waves before disability onset
* -2 = two waves before
* -1 = one wave before
*  0 = first observed disability wave
* +1 = one wave after
* +2 = two waves after
********************************************************************************

capture drop disability_eventtime

gen disability_eventtime = ///
    wave - first_disability_wave ///
    if first_disability_wave<.

tab disability_eventtime, missing


********************************************************************************
* 6. CREATE SHIFTED EVENT-PERIOD VARIABLE
*
* disability_eventtime      event_period
*
*       -3                       0
*       -2                       1
*       -1                       2   <-- REFERENCE
*        0                       3
*       +1                       4
*       +2                       5
********************************************************************************

capture drop event_period

gen event_period = ///
    disability_eventtime + 3 ///
    if inrange(disability_eventtime,-3,2)

label define event_period_lbl ///
    0 "3 waves before" ///
    1 "2 waves before" ///
    2 "1 wave before" ///
    3 "Disability onset" ///
    4 "1 wave after" ///
    5 "2 waves after", replace

label values event_period event_period_lbl

tab event_period, missing


********************************************************************************
* 7. CREATE PREVIOUS-WAVE EMPLOYMENT
*
* Only consecutive waves are used to define previous-wave employment.
********************************************************************************

capture drop Employed_L1

bysort pidp (wave): gen Employed_L1 = ///
    Employed[_n-1] ///
    if wave==wave[_n-1]+1

tab Employed_L1, missing


********************************************************************************
* 8. CREATE EMPLOYMENT-EXIT VARIABLE
*
* LostEmployment = 1:
* Employed in the immediately preceding wave and not employed in current wave.
*
* LostEmployment = 0:
* Employed in the immediately preceding wave and remains employed.
********************************************************************************

capture drop LostEmployment

gen LostEmployment = ///
    (Employed_L1==1 & Employed==0) ///
    if Employed_L1==1 & Employed<.

tab LostEmployment, missing


********************************************************************************
* 9. CHECK VARIABLE CONSTRUCTION
********************************************************************************

sort pidp wave

list pidp wave ///
    Disabled ///
    first_obs ///
    disabled_at_entry ///
    first_disability_wave ///
    disability_eventtime ///
    event_period ///
    acquired_disability ///
    Employed_L1 ///
    Employed ///
    LostEmployment ///
    if first_disability_wave<. ///
    & disabled_at_entry==0 ///
    in 1/150, sepby(pidp)


********************************************************************************
* 10. SAMPLE COUNTS
********************************************************************************

capture drop tag_person

egen tag_person = tag(pidp)

* Number of respondents who acquire disability during observation
* after entering the survey non-disabled

count if tag_person==1 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

* Number of person-wave observations for this group

count if first_disability_wave<. ///
    & disabled_at_entry==0


********************************************************************************
* 11. MODEL 1
* EMPLOYMENT BEFORE VS AT DISABILITY ONSET
********************************************************************************

svy: logit Employed ///
    acquired_disability ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if disability_eventtime<=0 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

est store DisabilityOnset_Employed


********************************************************************************
* 12. MODEL 2
* PEET BEFORE VS AT DISABILITY ONSET
********************************************************************************

svy: logit PEET ///
    acquired_disability ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if disability_eventtime<=0 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

est store DisabilityOnset_PEET


********************************************************************************
* 13. MODEL 3
* EMPLOYMENT EXIT AT DISABILITY ONSET
*
* Among observations where the respondent was employed in the immediately
* preceding wave, test whether employment exit is more likely in the
* disability-onset wave.
********************************************************************************

svy: logit LostEmployment ///
    acquired_disability ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if Employed_L1==1 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

est store DisabilityEmploymentExit


********************************************************************************
* 14. MODEL 4
* EVENT-TIME MODEL: EMPLOYMENT
*
* Reference category:
* event_period = 2 = one wave before disability onset.
********************************************************************************

svy: logit Employed ///
    ib2.event_period ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if event_period<. ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

est store DisabilityEventStudy


********************************************************************************
* 15. MODEL 5
* EVENT-TIME MODEL: PEET
********************************************************************************

svy: logit PEET ///
    ib2.event_period ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if event_period<. ///
    & first_disability_wave<. ///
    & disabled_at_entry==0

est store DisabilityEventStudy_PEET


********************************************************************************
* 16. MODEL 6
* RANDOM-EFFECTS EMPLOYMENT MODEL
********************************************************************************

xtlogit Employed ///
    acquired_disability ///
    Fem dvage Age2 HighEducation ///
    Single Seperated ///
    WhiteOther OtherEthnicity ///
    if disability_eventtime<=0 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0, ///
    re i(pidp)

est store DisabilityOnset_RE


********************************************************************************
* 17. MODEL 7
* FIXED-EFFECTS EMPLOYMENT MODEL
*
* Time-invariant sex and ethnicity variables are not included.
********************************************************************************

xtlogit Employed ///
    acquired_disability ///
    dvage Age2 HighEducation ///
    Single Seperated ///
    if disability_eventtime<=0 ///
    & first_disability_wave<. ///
    & disabled_at_entry==0, ///
    fe i(pidp)

est store DisabilityOnset_FE


********************************************************************************
* 18. MARGINS: SIMPLE EMPLOYMENT-ONSET MODEL
********************************************************************************

est restore DisabilityOnset_Employed

margins, at(acquired_disability=(0 1))


********************************************************************************
* 19. EVENT-TIME MARGINS: EMPLOYMENT
********************************************************************************

est restore DisabilityEventStudy

margins event_period

matrix EmploymentMargins = r(table)

matrix list EmploymentMargins


********************************************************************************
* 20. EVENT-TIME MARGINS: PEET
********************************************************************************

est restore DisabilityEventStudy_PEET

margins event_period

matrix PEETMargins = r(table)

matrix list PEETMargins


********************************************************************************
* 21. FINAL THESIS FIGURE
* PANEL A: EMPLOYMENT
********************************************************************************

est restore DisabilityEventStudy

margins event_period

marginsplot, ///
    recast(line) ///
    recastci(rarea) ///
    scheme(white_tableau) ///
    xlabel( ///
        0 "3 waves before" ///
        1 "2 waves before" ///
        2 "1 wave before" ///
        3 "Disability onset" ///
        4 "1 wave after" ///
        5 "2 waves after", ///
        angle(45)) ///
    xtitle("") ///
    ytitle("Predicted Probability") ///
    title("A. Employment", size(medium)) ///
    legend(off) ///
    xsize(7) ysize(5) ///
    name(DisabilityEmploymentMargins, replace)


********************************************************************************
* 22. FINAL THESIS FIGURE
* PANEL B: PEET
********************************************************************************

est restore DisabilityEventStudy_PEET

margins event_period

marginsplot, ///
    recast(line) ///
    recastci(rarea) ///
    scheme(white_tableau) ///
    xlabel( ///
        0 "3 waves before" ///
        1 "2 waves before" ///
        2 "1 wave before" ///
        3 "Disability onset" ///
        4 "1 wave after" ///
        5 "2 waves after", ///
        angle(45)) ///
