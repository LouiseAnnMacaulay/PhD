}


********************************************************************************

* Function to create graphs for each dependent variable and care location. 
program define LocationCare
    args var type
    * Run the regression model
    if "`type'" == "Dependent" {
        xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean Asian Indian Arab Mixed Other Single Seperated HouseholdCarer NonResidentCarer MixedCareLocations
    }
    est store `var'_LC1
end

* Loop over each dependent for care location.
