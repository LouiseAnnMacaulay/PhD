
*** Just change the local dependent variables depending on chapter *** 

*** All options: 

local Dependent_Variables "PEET Employed PartTime TempJob ZeroHours FlexiTime WorkHome JobStress MayLoseJob MayQuitJob PublicCompany ManagerResponsibility RedundantSacked"

********************************************************************************
* UC
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated UnpaidCarer

    capture estimates store `var'_UC1
}


********************************************************************************
* NC1
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        Care1 Care2 Care3or4 

    capture estimates store `var'_NC1
}

********************************************************************************
* HC1
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        Under10 Under19 Over20 Over50 ///
      
    capture estimates store `var'_HC1
}

********************************************************************************
* DC1
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated DisabledCarer NoDCarer 

    capture estimates store `var'_DC1
}

********************************************************************************
* LC1
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        HouseholdCarer MixedCareLocations NonResidentCarer 

    capture estimates store `var'_LC1
}



********************************************************************************
* NC2
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        Care2 Care3or4 ///
        if Care1==1 | Care2==1 | Care3or4==1

    capture estimates store `var'_NC2
}

********************************************************************************
* HC2
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        Under19 Over20 Over50 ///
        if Under10==1 | Under19==1 | Over20==1 | Over50==1

    capture estimates store `var'_HC2
}

********************************************************************************
* DC2
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated DisabledCarer ///
        if DisabledCarer==1 | NoDCarer==1

    capture estimates store `var'_DC2
}

********************************************************************************
* LC2
********************************************************************************
foreach var of local Dependent_Variables {

    xtlogit `var' Fem dvage Age2 HighEducation White AfricanCaribbean ///
        Asian Indian Arab Mixed Other Single Seperated ///
        MixedCareLocations NonResidentCarer ///
        if HouseholdCarer==1 | NonResidentCarer==1

    capture estimates store `var'_LC2
}

