********************************************************************************
* INTERACTION EFFECTS *
********************************************************************************


* 1. Disability interaction
xtlogit PEET Fem AgeCat HighEducation White AfricanCaribbean Asian Indian OtherEthnicities ///
    Single Seperated ib0.UnpaidCarer##ib0.Disabled, i(pidp)
est store UCDI_UK

* 2. Gender interaction
xtlogit PEET AgeCat HighEducation White AfricanCaribbean Asian Indian OtherEthnicities ///
    Single Seperated ib0.UnpaidCarer##ib0.Fem, i(pidp)
est store UCFI_UK

* 3. Education interaction
xtlogit PEET Fem AgeCat White AfricanCaribbean Asian Indian OtherEthnicities ///
    Single Seperated ib0.UnpaidCarer##ib0.HighEducation, i(pidp)
est store UCEI_UK

* 4. Age interaction
xtlogit PEET Fem HighEducation White AfricanCaribbean Asian Indian OtherEthnicities ///
    Single Seperated ib0.UnpaidCarer##ib0.AgeCat, i(pidp)
est store UCAI_UK

* 5. Household structure interaction
xtlogit PEET Fem AgeCat HighEducation White AfricanCaribbean Asian Indian OtherEthnicities ///
    ib0.UnpaidCarer##ib0.Single ib0.UnpaidCarer##ib0.Seperated, i(pidp)
est store UCMI_UK

* 6. Ethnicity interaction
xtlogit PEET Fem AgeCat HighEducation Single Seperated ///
    ib0.UnpaidCarer##ib0.White ///
    ib0.UnpaidCarer##ib0.AfricanCaribbean ///
    ib0.UnpaidCarer##ib0.Asian ///
    ib0.UnpaidCarer##ib0.Indian ///
    ib0.UnpaidCarer##ib0.OtherEthnicities, i(pidp)
est store UCETHI_UK

coefplot ///
    (UCDI_UK, label("Disability")) ///
    (UCFI_UK, label("Gender")) ///
    (UCEI_UK, label("Education")) ///
    (UCAI_UK, label("Age")) ///
    (UCMI_UK, label("Household structure")) ///
    (UCETHI_UK, label("Ethnicity")) ///
    , ///
    keep(*UnpaidCarer#*) ///
    eform ///
    scheme(white_tableau) ///
    graphregion(fcolor(white)) ///
    aspect(0) ///
    xline(1, lcolor(black) lwidth(medium)) ///
    grid(between glpattern(dash) glwidth(*0.5) glcolor(gray%20)) ///
    xlabel(, notick) ///
    ylabel(, labsize(vsmall) notick) ///
    legend(pos(7) ring(2) col(3) size(vsmall)) ///
    msize(vsmall) ///
    msymbol(D) ///
    ciopts(lwidth(vthin)) ///
    title("UKHLS: Interaction Effects of Caregiving on PEET (Odds Ratios)", span size(*1) linegap(2)) ///
    ytitle("") ///
    xtitle("")

	
