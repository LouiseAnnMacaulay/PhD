*******************************************************************************
* SHS: LIFE SATISFACTION – EMPLOYMENT × UNPAID CARE
*******************************************************************************

program drop _all

*******************************************************************************
* GLOBALS
*******************************************************************************

local EmploymentVars "PartTime ManagerSupervisor CareFlexibleWork"

local Controls "fem AgeCat HighEducation OWhite AsianAndOther Single Seperated"

*******************************************************************************
* CARE GROUPS
*******************************************************************************

local CareGroup1 "Carer"

local CareGroup2 "Hours4 Hours19 Hours49 Hours50 HoursV"

local CareGroup3 "Under1Year Under5Years Under10Years Over10Years"

local CareGroup4 "CareAtHome CareOutsideHome CareMultipleHome"

local CareGroup5 "GetsHelp"

local CareGroup6 "CarerNoDisability DisabledCarer"

*******************************************************************************
* PROGRAM: RUN MODEL + PLOT
*******************************************************************************

program define RunInteraction

    args emp care title

    *-------------------------------
    * MODEL
    *-------------------------------
    logit SatisfiedLife ///
        `Controls' ///
        i.`emp'##i.`care' ///
        [pweight=CombinedWeight]

    *-------------------------------
    * TEST INTERACTION
    *-------------------------------
    capture testparm i.`emp'#i.`care'

    if _rc != 0 {
        di "Skipping `emp' × `care' (not estimable)"
        exit
    }

    scalar pval = r(p)

    *-------------------------------
    * MARGINS
    *-------------------------------
    margins, at(`emp'=(0 1) `care'=(0 1)) level(95)

    *====================================================
    * LABEL CONVERSION (NEW IMPROVEMENT)
    *====================================================

    local care_label "`care'"

    if "`care'" == "Hours4" local care_label "0–4 hours"
    if "`care'" == "Hours19" local care_label "5–19 hours"
    if "`care'" == "Hours49" local care_label "20–49 hours"
    if "`care'" == "Hours50" local care_label "50+ hours"
    if "`care'" == "HoursV" local care_label "Variable hours"

    if "`care'" == "Under1Year" local care_label "<1 year"
    if "`care'" == "Under5Years" local care_label "1–5 years"
    if "`care'" == "Under10Years" local care_label "5–10 years"
    if "`care'" == "Over10Years" local care_label "10+ years"

    if "`care'" == "CareAtHome" local care_label "At home"
    if "`care'" == "CareOutsideHome" local care_label "Outside home"
    if "`care'" == "CareMultipleHome" local care_label "Multiple homes"

    if "`care'" == "GetsHelp" local care_label "Receives help"

    if "`care'" == "CarerNoDisability" local care_label "No disability"
    if "`care'" == "DisabledCarer" local care_label "Disabled carer"

    if "`care'" == "Carer" local care_label "Carer status"

    *====================================================
    * PLOTS (WITH COLOUR RULE)
    *====================================================

    if pval < 0.05 {

        marginsplot, scheme(Rainbow) ///
            plot1opts(lcolor(orange_red) lpattern(solid)) ///
            plot2opts(lcolor(dkorange) lpattern(dash)) ///
            recastci(rarea) ciopts(fcolor(%40)) ///
            title("`care_label'") ///
            ytitle("Life Satisfaction") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(`emp'_`care'.gph, replace)

    }
    else {

        marginsplot, scheme(tab2) ///
            plot1opts(lcolor(navy) lpattern(solid)) ///
            plot2opts(lcolor(edkblue) lpattern(dash)) ///
            recastci(rarea) ciopts(fcolor(%40)) ///
            title("`care_label'") ///
            ytitle("Life Satisfaction") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
            saving(`emp'_`care'.gph, replace)

    }

end

*******************************************************************************
* SECTION 1: CARER STATUS
*******************************************************************************

foreach emp in `EmploymentVars' {
    RunInteraction `emp' Carer "Carer × `emp'"
}

*******************************************************************************
* SECTION 2: HOURS OF CARE
*******************************************************************************

foreach emp in `EmploymentVars' {
    foreach care in `CareGroup2' {
        RunInteraction `emp' `care' "Hours × `emp'"
    }
}

*******************************************************************************
* SECTION 3: DURATION
*******************************************************************************

foreach emp in `EmploymentVars' {
    foreach care in `CareGroup3' {
        RunInteraction `emp' `care' "Duration × `emp'"
    }
}

*******************************************************************************
* SECTION 4: CARE LOCATION
*******************************************************************************

foreach emp in `EmploymentVars' {
    foreach care in `CareGroup4' {
        RunInteraction `emp' `care' "Location × `emp'"
    }
}

*******************************************************************************
* SECTION 5: HELP
*******************************************************************************

foreach emp in `EmploymentVars' {
    foreach care in `CareGroup5' {
        RunInteraction `emp' `care' "Help × `emp'"
    }
}

*******************************************************************************
* SECTION 6: DISABILITY STATUS
*******************************************************************************

foreach emp in `EmploymentVars' {
    foreach care in `CareGroup6' {
        RunInteraction `emp' `care' "Disability × `emp'"
    }
}


*******************************************************************************
* PART-TIME GRAPH COMBINE
*******************************************************************************

graph combine ///
PartTime_Carer.gph ///
PartTime_Hours4.gph PartTime_Hours19.gph PartTime_Hours49.gph PartTime_Hours50.gph PartTime_HoursV.gph ///
PartTime_Under1Year.gph PartTime_Under5Years.gph PartTime_Under10Years.gph PartTime_Over10Years.gph ///
PartTime_CareAtHome.gph PartTime_CareOutsideHome.gph PartTime_CareMultipleHome.gph ///
PartTime_GetsHelp.gph PartTime_CarerNoDisability.gph PartTime_DisabledCarer.gph, ///
name(Combined_PartTime, replace) ///
title("SHS: Life Satisfaction, Part-Time and Unpaid Care", size(medium)) ///
note("Orange = significant interaction. Blue = non-significant. Dashed lines indicate non-carer comparison group.", span size (*.7) margin(small)) ///
ysize(8)

*******************************************************************************
* MANAGER GRAPH COMBINE
*******************************************************************************

graph combine ///
ManagerSupervisor_Carer.gph ///
ManagerSupervisor_Hours4.gph ManagerSupervisor_Hours19.gph ManagerSupervisor_Hours49.gph ManagerSupervisor_Hours50.gph ManagerSupervisor_HoursV.gph ///
ManagerSupervisor_Under1Year.gph ManagerSupervisor_Under5Years.gph ManagerSupervisor_Under10Years.gph ManagerSupervisor_Over10Years.gph ///
ManagerSupervisor_CareAtHome.gph ManagerSupervisor_CareOutsideHome.gph ManagerSupervisor_CareMultipleHome.gph ///
ManagerSupervisor_GetsHelp.gph ManagerSupervisor_CarerNoDisability.gph ManagerSupervisor_DisabledCarer.gph, ///
name(Combined_ManagerSupervisor, replace) ///
title("SHS: Life Satisfaction, Managerial Responsibility and Unpaid Care", size(medium)) ///
note("Orange = significant interaction. Blue = non-significant. Dashed lines indicate non-carer comparison group.", span size (*.7) margin(small)) ///
ysize(8)

*******************************************************************************
* FLEXIBILITY GRAPH COMBINE
*******************************************************************************


graph combine ///
CareFlexibleWork_Hours4.gph CareFlexibleWork_Hours19.gph CareFlexibleWork_Hours49.gph CareFlexibleWork_Hours50.gph CareFlexibleWork_HoursV.gph ///
CareFlexibleWork_Under1Year.gph CareFlexibleWork_Under5Years.gph CareFlexibleWork_Under10Years.gph CareFlexibleWork_Over10Years.gph ///
CareFlexibleWork_CareAtHome.gph CareFlexibleWork_CareOutsideHome.gph CareFlexibleWork_CareMultipleHome.gph ///
CareFlexibleWork_GetsHelp.gph CareFlexibleWork_CarerNoDisability.gph CareFlexibleWork_DisabledCarer.gph, ///
name(Combined_CareFlexibleWork, replace) ///
title("SHS: Life Satisfaction, Flexible Working and Unpaid Care", size(medium)) ///
note("Orange = significant interaction. Blue = non-significant. Dashed lines indicate non-carer comparison group.", span size (*.7) margin(small)) ///
ysize(8)
