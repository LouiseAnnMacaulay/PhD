**************************************************************************
**************************************************************************
* Occupation Sector and Health
* Survey-weighted multinomial logistic regression
**************************************************************************
**************************************************************************

clear matrix
estimates clear


**************************************************************************
* Restrict to employed respondents
**************************************************************************

capture drop OccupationSample

gen OccupationSample = ///
    Employed==1 ///
    & OccupationClassification < . ///
    & Fem < . ///
    & dvage < . ///
    & Age2 < . ///
    & HighEducation < . ///
    & Single < . ///
    & Seperated < . ///
    & WhiteOther < . ///
    & OtherEthnicity < .


**************************************************************************
* Set reference occupation category
* 4 = Retail/Hospitality
**************************************************************************

fvset base 4 OccupationClassification

**************************************************************************
**************************************************************************
* MODEL 1
* Disability status
**************************************************************************
**************************************************************************

svy: mlogit OccupationClassification ///
    i.Disabled ///
    i.Fem ///
    c.dvage ///
    c.Age2 ///
    i.HighEducation ///
    i.Single ///
    i.Seperated ///
    i.WhiteOther ///
    i.OtherEthnicity ///
    if OccupationSample==1, ///
    baseoutcome(4)

est store Occupation_Disability



**************************************************************************
**************************************************************************
* MODEL 2
* Has general health condition
**************************************************************************
**************************************************************************

svy: mlogit OccupationClassification ///
    i.HealthCondition ///
    i.Fem ///
    c.dvage ///
    c.Age2 ///
    i.HighEducation ///
    i.Single ///
    i.Seperated ///
    i.WhiteOther ///
    i.OtherEthnicity ///
    if OccupationSample==1, ///
    baseoutcome(4)

est store Occupation_HealthCondition



**************************************************************************
**************************************************************************
* MODEL 3
* Self-rated health as fair/poor
**************************************************************************
**************************************************************************

svy: mlogit OccupationClassification ///
    i.HealthNotGood ///
    i.Fem ///
    c.dvage ///
    c.Age2 ///
    i.HighEducation ///
    i.Single ///
    i.Seperated ///
    i.WhiteOther ///
    i.OtherEthnicity ///
    if OccupationSample==1, ///
    baseoutcome(4)

est store Occupation_HealthRating



**************************************************************************
**************************************************************************
* MODEL 4
* Broad health conditions
**************************************************************************
**************************************************************************

svy: mlogit OccupationClassification ///
    i.HasHC ///
    i.MentalHealth ///
    i.Fem ///
    c.dvage ///
    c.Age2 ///
    i.HighEducation ///
    i.Single ///
    i.Seperated ///
    i.WhiteOther ///
    i.OtherEthnicity ///
    if OccupationSample==1, ///
    baseoutcome(4)

est store Occupation_MentalHealth



**************************************************************************
**************************************************************************
* SPECIFIC HEALTH CONDITIONS
**************************************************************************
**************************************************************************

local conditions ///
MentalHealth ///
Epilepsy ///
Thyroid ///
Lung ///
Heart ///
Arthritis ///
Diabetes ///
Cancer ///
Liver


foreach x of local conditions {

    svy: mlogit OccupationClassification ///
        i.HasHC ///
        i.`x' ///
        i.Fem ///
        c.dvage ///
        c.Age2 ///
        i.HighEducation ///
        i.Single ///
        i.Seperated ///
        i.WhiteOther ///
        i.OtherEthnicity ///
        if OccupationSample==1, ///
        baseoutcome(4)

    est store Occupation_`x'

}



**************************************************************************
**************************************************************************
* FUNCTIONAL LIMITATIONS (Called Inhibiting Symptom at earlier date)
**************************************************************************
**************************************************************************

local limitations ///
Mobility ///
Lifting ///
ManualDexterity ///
Continence ///
Hearing ///
Sight ///
Communication ///
Memory ///
RDanger ///
Coordination ///
PersonalCare ///
OtherHCPB ///
Inhibiting_Symptom



foreach x of local limitations {

    svy: mlogit OccupationClassification ///
        i.HasPB ///
        i.`x' ///
        i.Fem ///
        c.dvage ///
        c.Age2 ///
        i.HighEducation ///
        i.Single ///
        i.Seperated ///
        i.WhiteOther ///
        i.OtherEthnicity ///
        if OccupationSample==1, ///
        baseoutcome(4)

    est store Occupation_`x'

}



**************************************************************************
* Check stored models
**************************************************************************

estimates dir



**************************************************************************
**************************************************************************
* MAIN REGRESSION TABLE
**************************************************************************
**************************************************************************

est table ///
Occupation_Disability ///
Occupation_HealthCondition ///
Occupation_HealthRating ///
Occupation_MentalHealth ///
Occupation_Epilepsy ///
Occupation_Thyroid ///
Occupation_Lung ///
Occupation_Heart ///
Occupation_Arthritis ///
Occupation_Diabetes ///
Occupation_Cancer ///
Occupation_Liver, ///
eform ///
b(%8.3f) ///
star ///
stats(N)



**************************************************************************
* Functional limitation table
**************************************************************************

est table ///
Occupation_Mobility ///
Occupation_Lifting ///
Occupation_ManualDexterity ///
Occupation_Continence ///
Occupation_Hearing ///
Occupation_Sight ///
Occupation_Communication ///
Occupation_Memory ///
Occupation_RDanger ///
Occupation_Coordination ///
Occupation_PersonalCare ///
Occupation_OtherHCPB ///
Occupation_Inhibiting_Symptom, ///
eform ///
b(%8.3f) ///
star ///
stats(N)
