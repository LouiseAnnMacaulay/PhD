local Dependent_Variables "PEET Employed PartTime TempJob ZeroHours FlexiTime WorkHome JobStress MayLoseJob MayQuitJob PublicCompany ManagerResponsibility RedundantSacked"

* Drop existing program definitions if they exist
program drop _all

********************************************************************************

program define UnpaidCare
    args var type
    * Run the regression model
    if "`type'" == "UnpaidCare1" {
        xtlogit SatisfiedLife Fem dvage Age2 HighEducation White AfricanCaribbean Asian Indian Arab Mixed Other Single Seperated i.UnpaidCarer##i.`var'
    }
    est store `var'
    
    * Test the significance of the interaction term
    testparm i.`var'#i.UnpaidCarer
    
    * Extract the p-value
    scalar pval = r(p)
    
    * Run margins and marginsplot based on significance
    if pval < 0.05 {
        di "Significant interaction for `var' with p-value = " pval
        * Significant interaction: use Rainbow scheme
        margins, at(`var'=(0(1)1) UnpaidCarer=(0(1)1)) level(95)
        marginsplot, scheme(Rainbow) ///
            plot1opts(lwidth(medium) lcolor(orange_red) lpattern(solid)) ///
			plot2opts(lwidth(medium) lcolor(dkorange) lpattern(dash)) ///
            recastci(rarea) ciopts(fcolor(%40)) ///
            title("Unpaid Carer") ///
            xsize(5) ysize(5) ///
            xlab(, glcolor(gs15) glpattern(solid)) ///
            ylabel(none) ///
            ytitle("Life Satisfaction") ///
            legend(pos(6) ring(2) col(1) size(vsmall)) ///
			xlabel(0 "`var'= 0" 1 "`var'= 1", labsize(vsmall)) ///
			xtitle("`off'") ///
			graphregion(margin(l+5 r+5)) /// Adjusts the left and right margins
            saving(`var'_UnpaidCarer.gph, replace)
    }
    else {
		di "Non-significant interaction for `var' with p-value = " pval
* Non-significant interaction: use tab2 scheme
		margins, at(`var'=(0(1)1) UnpaidCarer=(0(1)1)) level(95)
	marginsplot, scheme(tab2) ///
		plot1opts(lwidth(medium) lcolor(navy) lpattern(solid)) ///
		plot2opts(lwidth(medium) lcolor(edkblue) lpattern(dash)) ///
		recastci(rarea) ciopts(fcolor(%40)) ///
		title("Unpaid Carer") ///
		xsize(5) ysize(5) ///
		xlab(, glcolor(gs15) glpattern(solid)) ///
		ylabel(none) ///
		ytitle("Life Satisfaction") ///
		legend(pos(6) ring(2) col(1) size(vsmall)) ///
		xlabel(0 "`var'= 0" 1 "`var'= 1", labsize(vsmall)) ///
		xtitle("`off'") ///
		graphregion(margin(l+5 r+5)) /// Adjusts the left and right margins
		saving(`var'_UnpaidCarer.gph, replace)
	 }
end


* Loop over each health condition
foreach var of local Dependent_Variables {
    UnpaidCare `var' UnpaidCare1
}



